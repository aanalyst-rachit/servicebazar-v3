export type StudyMaterial = {
  id: string;
  materialName: string;
  materialDetails: string;
  pdfName: string;
  pdfUrl: string;
  createdAt?: unknown;
  updatedAt?: unknown;
};

const STUDY_MATERIALS_COLLECTION =
  'studyMaterials';

export async function saveStudyMaterial(
  serviceBazarUid: string,
  material: Omit<
    StudyMaterial,
    'id' | 'createdAt' | 'updatedAt'
  >
): Promise<string> {
  if (!serviceBazarUid) {
    throw new Error(
      'ServiceBazar user ID is required.'
    );
  }

  const materialsRef = collection(
    db,
    COLLECTION_NAME,
    serviceBazarUid,
    STUDY_MATERIALS_COLLECTION
  );

  const materialRef = await addDoc(materialsRef, {
    materialName: material.materialName,
    materialDetails: material.materialDetails,
    pdfName: material.pdfName,
    pdfUrl: material.pdfUrl,
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });

  return materialRef.id;
}

export async function updateStudyMaterial(
  serviceBazarUid: string,
  materialId: string,
  material: Omit<
    StudyMaterial,
    'id' | 'createdAt' | 'updatedAt'
  >
): Promise<void> {
  if (!serviceBazarUid) {
    throw new Error(
      'ServiceBazar user ID is required.'
    );
  }

  if (!materialId) {
    throw new Error(
      'Study material ID is required.'
    );
  }

  const materialRef = doc(
    db,
    COLLECTION_NAME,
    serviceBazarUid,
    STUDY_MATERIALS_COLLECTION,
    materialId
  );

  await updateDoc(materialRef, {
    materialName: material.materialName,
    materialDetails: material.materialDetails,
    pdfName: material.pdfName,
    pdfUrl: material.pdfUrl,
    updatedAt: serverTimestamp(),
  });
}

export async function deleteStudyMaterial(
  serviceBazarUid: string,
  materialId: string
): Promise<void> {
  if (!serviceBazarUid) {
    throw new Error(
      'ServiceBazar user ID is required.'
    );
  }

  if (!materialId) {
    throw new Error(
      'Study material ID is required.'
    );
  }

  const materialRef = doc(
    db,
    COLLECTION_NAME,
    serviceBazarUid,
    STUDY_MATERIALS_COLLECTION,
    materialId
  );

  await deleteDoc(materialRef);
}

export async function getStudyMaterials(
  serviceBazarUid: string
): Promise<StudyMaterial[]> {
  if (!serviceBazarUid) {
    return [];
  }

  const materialsRef = collection(
    db,
    COLLECTION_NAME,
    serviceBazarUid,
    STUDY_MATERIALS_COLLECTION
  );

  const materialsQuery = query(
    materialsRef,
    orderBy('createdAt', 'desc')
  );

  const snapshot = await getDocs(materialsQuery);

  return snapshot.docs.map((materialDoc) => ({
    id: materialDoc.id,
    ...(materialDoc.data() as Omit<
      StudyMaterial,
      'id'
    >),
  }));
}

